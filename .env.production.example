# MongoDB Atlas Connection String
# Replace <PASSWORD> with your actual password from MongoDB Atlas
MONGODB_URI=mongodb+srv://chalak-api:<PASSWORD>@cluster0.xxxxx.mongodb.net/chalak-mobility?retryWrites=true&w=majority

# JWT Secret (generate a new one)
JWT_SECRET=your-super-secure-jwt-secret-key-256-bits-long-change-this

# API Configuration
NODE_ENV=production
PORT=3000
API_BASE_URL=https://your-api-name.onrender.com

# CORS
ALLOWED_ORIGINS=https://your-app-name.vercel.app,https://www.your-domain.com
