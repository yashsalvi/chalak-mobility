{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/apps/shop/browser",
  "installCommand": "npm install",
  "framework": "angular",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://chalak-mobility-api.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
