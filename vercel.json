{
  "version": 2,
  "name": "chalak-mobility",
  "builds": [
    {
      "src": "dist/apps/shop/server/server.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "dist/apps/shop/browser/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://chalak-mobility-api.onrender.com/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "dist/apps/shop/server/server.mjs"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
